<CsoundSynthesizer>
<CsOptions>
-d
</CsOptions>
<CsInstruments>
sr = 48000
ksmps = 32
nchnls = 2
0dbfs = 1

; Steps. Five lines reflect between MIDI 24 and MIDI 96 and repeat until
; six minutes. A line has a prime number of notes, 13 then 17, 19, 23, 29.
; One pass does not fill the six minutes. Instrument n is MIDI channel n-1.
; An eighth note is 0.5 seconds. The 13-note line sounds for 5 eighths, and
; each longer line is one eighth shorter, down to a single eighth. After a
; note, the line rests for four times that length.

gaLeft init 0
gaRight init 0
giSine ftgen 0, 0, 65536, 10, 1

instr 1
  iHz = cpsmidinn(p4)
  iAmp = ampdbfs(-27 + 8 * (p5 / 127))
  iPan = limit(p7, 0, 1)
  iPhase = frac(p9)
  iPitches = p10
  iHomogeneity = p11
  aRise linseg 0, 0.004, 1
  aFall expon 1, p3, 0.001
  aTone poscil3 0.72, iHz, giSine, iPhase
  aOctave poscil3 0.28, iHz * 2, giSine, iPhase
  aLeft, aRight pan2 (aTone + aOctave) * aRise * aFall * iAmp, iPan
  out aLeft * 0.82, aRight * 0.82
  gaLeft += aLeft * 0.22
  gaRight += aRight * 0.22
endin

instr 2
  iHz = cpsmidinn(p4)
  iAmp = ampdbfs(-27 + 8 * (p5 / 127))
  iPan = limit(p7, 0, 1)
  iPhase = frac(p9)
  iPitches = p10
  iHomogeneity = p11
  aRise linseg 0, 0.004, 1
  aFall expon 1, p3, 0.001
  aTone poscil3 0.72, iHz, giSine, iPhase
  aOctave poscil3 0.28, iHz * 2, giSine, iPhase
  aLeft, aRight pan2 (aTone + aOctave) * aRise * aFall * iAmp, iPan
  out aLeft * 0.82, aRight * 0.82
  gaLeft += aLeft * 0.22
  gaRight += aRight * 0.22
endin

instr 3
  iHz = cpsmidinn(p4)
  iAmp = ampdbfs(-27 + 8 * (p5 / 127))
  iPan = limit(p7, 0, 1)
  iPhase = frac(p9)
  iPitches = p10
  iHomogeneity = p11
  aRise linseg 0, 0.004, 1
  aFall expon 1, p3, 0.001
  aTone poscil3 0.72, iHz, giSine, iPhase
  aOctave poscil3 0.28, iHz * 2, giSine, iPhase
  aLeft, aRight pan2 (aTone + aOctave) * aRise * aFall * iAmp, iPan
  out aLeft * 0.82, aRight * 0.82
  gaLeft += aLeft * 0.22
  gaRight += aRight * 0.22
endin

instr 4
  iHz = cpsmidinn(p4)
  iAmp = ampdbfs(-27 + 8 * (p5 / 127))
  iPan = limit(p7, 0, 1)
  iPhase = frac(p9)
  iPitches = p10
  iHomogeneity = p11
  aRise linseg 0, 0.004, 1
  aFall expon 1, p3, 0.001
  aTone poscil3 0.72, iHz, giSine, iPhase
  aOctave poscil3 0.28, iHz * 2, giSine, iPhase
  aLeft, aRight pan2 (aTone + aOctave) * aRise * aFall * iAmp, iPan
  out aLeft * 0.82, aRight * 0.82
  gaLeft += aLeft * 0.22
  gaRight += aRight * 0.22
endin

instr 5
  iHz = cpsmidinn(p4)
  iAmp = ampdbfs(-27 + 8 * (p5 / 127))
  iPan = limit(p7, 0, 1)
  iPhase = frac(p9)
  iPitches = p10
  iHomogeneity = p11
  aRise linseg 0, 0.004, 1
  aFall expon 1, p3, 0.001
  aTone poscil3 0.72, iHz, giSine, iPhase
  aOctave poscil3 0.28, iHz * 2, giSine, iPhase
  aLeft, aRight pan2 (aTone + aOctave) * aRise * aFall * iAmp, iPan
  out aLeft * 0.82, aRight * 0.82
  gaLeft += aLeft * 0.22
  gaRight += aRight * 0.22
endin

instr 99
  aLeft, aRight reverbsc gaLeft, gaRight, 0.72, 8000
  out aLeft * 0.45, aRight * 0.45
  clear gaLeft, gaRight
endin

</CsInstruments>
